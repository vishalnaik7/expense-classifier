# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Database Configuration
# Local/dev default (no PostgreSQL needed):
DATABASE_URL=sqlite:///expense.db
# When running via docker-compose this is overridden to:
# postgresql://postgres:password@postgres:5432/expense_db

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Upload limits
MAX_CONTENT_LENGTH=10485760

# AI features (AI Assistant chat, goal savings advice, AI-assisted
# CSV/PDF parsing fallback) run on an open-source model - no Anthropic/
# OpenAI paid API involved. See ARCHITECTURE.md for the full picture.
#
# Local development (default): AI_PROVIDER=ollama, talking to a local
# Ollama server. Install Ollama, run `ollama pull llama3.1`, then
# `ollama serve` (or just leave the Ollama desktop app running) before
# starting the backend. No API key needed.
AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1
#
# Production: Ollama cannot run on a serverless/static host, so switch to
# a hosted provider instead. Pick one:
#
# Groq - open-source models (Llama, GPT-OSS, Qwen, etc.) behind a
# free-tier, OpenAI-compatible API. Get a free key at
# https://console.groq.com, then set:
# AI_PROVIDER=groq
# GROQ_API_KEY=
# AI_MODEL=openai/gpt-oss-120b
#
# Gemini - Google's models via their OpenAI-compatible endpoint. Get a
# free key at https://aistudio.google.com/apikey, then set:
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# AI_MODEL=gemini-3.7-flash
#
# Mistral - get a key at https://console.mistral.ai, then set:
# AI_PROVIDER=mistral
# MISTRAL_API_KEY=
# AI_MODEL=mistral-large-latest
#
# Vision-capable model for PDFs with no extractable text layer at all
# (some banks, e.g. HDFC, draw statement "text" as vector glyph outlines
# with zero underlying character data - see ARCHITECTURE.md). Requires a
# separate, multimodal model from AI_MODEL above (Gemini and Mistral's
# models above are natively multimodal, so their vision model is the same
# as AI_MODEL; Ollama and Groq need a distinct one):
# - Ollama: `ollama pull llama3.2-vision` (default AI_VISION_MODEL value)
# - Groq: qwen/qwen3.6-27b (default for AI_PROVIDER=groq) - check
#   https://console.groq.com/docs/vision for the current model, since
#   Groq's lineup (and even their own deprecation-notice replacements)
#   changes without much notice
# AI_VISION_MODEL=llama3.2-vision
#
# Set AI_PROVIDER=none to disable all AI features entirely (uploads that
# fail deterministic parsing just return the parse error; chat and goal
# advice are unavailable).

LOG_LEVEL=DEBUG
