# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Database Configuration
# Local/dev default (no PostgreSQL needed):
DATABASE_URL=sqlite:///expense.db
# When running via docker-compose this is overridden to:
# postgresql://postgres:password@postgres:5432/expense_db

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Upload limits
MAX_CONTENT_LENGTH=10485760

# AI features (AI Assistant chat, goal savings advice, AI-assisted
# CSV/PDF parsing fallback) run on an open-source model - no Anthropic/
# OpenAI paid API involved. See ARCHITECTURE.md for the full picture.
#
# Local development (default): AI_PROVIDER=ollama, talking to a local
# Ollama server. Install Ollama, run `ollama pull llama3.1`, then
# `ollama serve` (or just leave the Ollama desktop app running) before
# starting the backend. No API key needed.
AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1
#
# Production: Ollama cannot run on a serverless/static host, so switch to
# a hosted provider instead. Pick one:
#
# Groq - open-source models (Llama, GPT-OSS, Qwen, etc.) behind a
# free-tier, OpenAI-compatible API. Get a free key at
# https://console.groq.com, then set:
# AI_PROVIDER=groq
# GROQ_API_KEY=
# AI_MODEL=openai/gpt-oss-120b
#
# Gemini - Google's models via their OpenAI-compatible endpoint. Get a
# free key at https://aistudio.google.com/apikey, then set:
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# AI_MODEL=gemini-3.7-flash
#
# Mistral - get a key at https://console.mistral.ai, then set:
# AI_PROVIDER=mistral
# MISTRAL_API_KEY=
# AI_MODEL=mistral-large-latest
#
# AI_VISION_MODEL (below) is only consulted by
# llm_extractor.extract_transactions_from_images() if you call it
# directly - the upload endpoint's PDF vision fallback (for statements
# with no extractable text layer at all, e.g. some HDFC PDFs - see
# ARCHITECTURE.md) always goes through AWS Textract first, then Bedrock
# (see services/textract_extractor.py, services/bedrock_vision.py, and
# the AWS section below), regardless of AI_PROVIDER:
# - Ollama: `ollama pull llama3.2-vision` (default AI_VISION_MODEL value)
# - Groq: qwen/qwen3.6-27b (default for AI_PROVIDER=groq) - check
#   https://console.groq.com/docs/vision for the current model, since
#   Groq's lineup (and even their own deprecation-notice replacements)
#   changes without much notice
# - Gemini/Mistral: same as AI_MODEL above (natively multimodal)
# AI_VISION_MODEL=llama3.2-vision
#
# AWS - the PDF-upload vision fallback specifically (see above). Needs
# an IAM user/role with textract:AnalyzeDocument and bedrock:InvokeModel.
#
# Textract is tried first and is the trusted result if it finds a table -
# it's OCR/layout-based table detection, not a generative model, so it
# doesn't hallucinate the way every model below does. Its output is
# reused through the same CSVParser every other input path goes through.
#
# If Textract can't find a recognizable table, Bedrock's Amazon Nova Lite
# is tried next (a generative vision model, and always treated as
# lower-confidence - see bedrock_vision.py's docstring for accuracy
# issues observed in testing), then Gemini and Mistral. Nova Lite is used
# rather than Bedrock's Claude models because Claude requires an AWS
# Marketplace subscription that can fail independently of IAM permissions
# (INVALID_PAYMENT_INSTRUMENT); Nova Lite, an Amazon first-party model,
# isn't subject to that.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# Some regions require a cross-region inference profile ID instead of
# the bare model ID for on-demand invocation - check
# `aws bedrock list-inference-profiles --region <region>` if this gets
# rejected.
# BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
#
# Set AI_PROVIDER=none to disable all AI features entirely (uploads that
# fail deterministic parsing just return the parse error; chat and goal
# advice are unavailable).

LOG_LEVEL=DEBUG
